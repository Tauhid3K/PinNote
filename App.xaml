<Application x:Class="PinNote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PinNote.UI"
             xmlns:viewmodels="clr-namespace:PinNote.ViewModels"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <viewmodels:MainViewModel x:Key="MainVM" />
            <ui:BooleanToPinTextConverter x:Key="BooleanToPinTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
