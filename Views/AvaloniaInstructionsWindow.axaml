<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinNote.Views.AvaloniaInstructionsWindow"
        Title="Welcome to PinNote - Quick Guide"
        Width="620"
        Height="680"
        MinWidth="480"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                      Fill="#0078D7" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Welcome to PinNote" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="A lightweight, feature-packed desktop sticky note application for Windows &amp; Linux."
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       FontSize="13" />
        </StackPanel>

        <!-- Guide Sections -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="12">
                <!-- Section 1: Create & Edit Notes -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                              Fill="#0078D7" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Create &amp; Edit Notes" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click '+ New Note' in the dashboard or use the tray icon context menu. You can drag any note by its title bar. Press Enter to add checklist items or Backspace to delete empty items."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 2: Pin Notes on Top -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                              Fill="#E67E22" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Pin Notes on Top" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the pin button on any note to keep it floating above all other open windows. Notes stay visible while you browse, write, or work."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 3: Workspace Groups -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                              Fill="#1F6FEB" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Workspace Groups" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Organize notes into separate workspaces (Default, University, Personal, Development, Projects). Switch workspaces directly from the dashboard top filter bar, or assign any note to a workspace via its options menu (...)."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 4: Reminders & Due Dates -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                              Fill="#E74C3C" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Reminders &amp; Due Dates" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Never miss a deadline. Set alarms on notes with quick presets (10 Minutes, 1 Hour, Today Evening, Tomorrow Morning, Next Week) or custom due dates. Overdue reminders trigger desktop notifications and are preserved across app restarts."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 5: Reusable Templates -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z"
                              Fill="#F39C12" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Reusable Templates" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Create notes in seconds from built-in student and productivity templates (Lecture Notes, Exam Preparation, Daily Planner, Meeting Notes, Project Planning). You can also save any note as a custom template for future use."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 6: Markdown Editing & Preview -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M20.56 18H3.44C2.65 18 2 17.37 2 16.59V7.41C2 6.63 2.65 6 3.44 6H20.56C21.35 6 22 6.63 22 7.41V16.59C22 17.37 21.35 18 20.56 18M6.81 15.19V11.53L8.73 13.88L10.65 11.53V15.19H12.56V8.81H10.65L8.73 11.16L6.81 8.81H4.89V15.19H6.81M17.69 12.06V8.81H15.78V12.06H13.88L16.73 15.19L19.59 12.06H17.69Z"
                              Fill="#27AE60" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Markdown Editing &amp; Live Preview" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Write structured notes using Markdown headings (#, ##), bullet lists, bold, italics, blockquotes, and code blocks. Toggle between edit mode and rendered preview mode anytime using the toolbar button or Ctrl+M."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 7: Update Notifications -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21M19.75,3.19L18.33,4.61C20.03,6.17 21,8.26 21,10.5H23C23,7.74 21.78,5.19 19.75,3.19M1,10.5H3C3,8.26 3.97,6.17 5.67,4.61L4.25,3.19C2.22,5.19 1,7.74 1,10.5Z"
                              Fill="#238636" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Automatic Update Notifications" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="PinNote checks for new releases on startup. When an update is published, a green '🔔 Update' notification badge appears on the dashboard header. Click it anytime to open the latest release page."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 8: Keyboard Shortcuts -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M19,7H5A2,2 0 0,0 3,9V17A2,2 0 0,0 5,19H19A2,2 0 0,0 21,17V9A2,2 0 0,0 19,7M7,15H5V13H7V15M7,11H5V9H7V11M11,15H9V13H11V15M11,11H9V9H11V11M15,15H13V13H15V15M15,11H13V9H15V11M19,15H17V13H19V15M19,11H17V9H19V11Z"
                              Fill="#3498DB" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Keyboard Shortcuts" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Ctrl+N (New Note) • Ctrl+F (Search notes) • Ctrl+M (Toggle Markdown preview) • Ctrl+P (Pin on top) • Ctrl+T (Checklist mode) • Ctrl+Alt+N (Global hotkey to capture notes instantly from anywhere)."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 9: Colors & Customization -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M12,2C6.49,2 2,6.49 2,12C2,17.51 6.49,22 12,22C13.38,22 14.5,20.88 14.5,19.5C14.5,18.86 14.24,18.28 13.82,17.86C13.41,17.45 13.15,16.89 13.15,16.27C13.15,14.9 14.27,13.78 15.64,13.78H18C20.21,13.78 22,11.99 22,9.78C22,5.48 17.52,2 12,2ZM6.5,12C5.67,12 5,11.33 5,10.5C5,9.67 5.67,9 6.5,9C7.33,9 8,9.67 8,10.5C8,11.33 7.33,12 6.5,12ZM9.5,8C8.67,8 8,7.33 8,6.5C8,5.67 8.67,5 9.5,5C10.33,5 11,5.67 11,6.5C11,7.33 10.33,8 9.5,8ZM14.5,8C13.67,8 13,7.33 13,6.5C13,5.67 13.67,5 14.5,5C15.33,5 16,5.67 16,6.5C16,7.33 15.33,8 14.5,8ZM17.5,12C16.67,12 16,11.33 16,10.5C16,9.67 16.67,9 17.5,9C18.33,9 19,9.67 19,10.5C19,11.33 18.33,12 17.5,12Z"
                              Fill="#9B59B6" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Colors &amp; Customization" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the palette button to customize note colors, change transparency, or adjust text font sizes. Enable Crystal Clear mode for a transparent frosted-glass overlay."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 10: System Tray Access -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                              Fill="#2ECC71" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="System Tray Access" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="PinNote stays in your system tray. Right-click the tray icon anytime to create notes, show/hide all notes, or switch themes (Light, Dark, or System)."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="0,10,0,0">
            <Button Content="Got it"
                    HorizontalAlignment="Right"
                    Background="#1F6FEB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    CornerRadius="6"
                    Padding="24,8"
                    Click="GotIt_Click"
                    Cursor="Hand" />
        </Border>
    </Grid>
</Window>
