<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinNote.Views.AvaloniaInstructionsWindow"
        Title="Welcome to PinNote - Quick Guide"
        Width="580"
        Height="620"
        MinWidth="450"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="📌" FontSize="26" VerticalAlignment="Center" />
                <TextBlock Text="Welcome to PinNote" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="A lightweight sticky note application for Windows &amp; Linux."
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       FontSize="13" />
        </StackPanel>

        <!-- Guide Sections -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="14">
                <!-- Section 1 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <TextBlock Grid.Column="0" Text="📝" FontSize="22" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Create &amp; Edit Notes" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click '+ New Note' in the dashboard or use the tray icon context menu. You can drag any note by its title bar."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 2 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <TextBlock Grid.Column="0" Text="📌" FontSize="22" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Pin Notes on Top" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the pin button 📌 on any note to keep it floating above all other open windows."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 3 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <TextBlock Grid.Column="0" Text="🎨" FontSize="22" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Colors &amp; Customization" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the palette button 🎨 to customize note colors, change transparency, or adjust text font sizes."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 4 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <TextBlock Grid.Column="0" Text="🔔" FontSize="22" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="System Tray Access" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="PinNote stays in your system tray. Right-click the tray icon anytime to create notes, show/hide all notes, or switch themes."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="0,10,0,0">
            <Button Content="Got it"
                    HorizontalAlignment="Right"
                    Background="#1F6FEB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    CornerRadius="6"
                    Padding="24,8"
                    Click="GotIt_Click"
                    Cursor="Hand" />
        </Border>
    </Grid>
</Window>
