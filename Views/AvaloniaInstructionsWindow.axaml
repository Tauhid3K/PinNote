<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinNote.Views.AvaloniaInstructionsWindow"
        Title="Welcome to PinNote - Quick Guide"
        Width="580"
        Height="620"
        MinWidth="450"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                      Fill="#0078D7" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Welcome to PinNote" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="A lightweight sticky note application for Windows &amp; Linux."
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       FontSize="13" />
        </StackPanel>

        <!-- Guide Sections -->
        <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Spacing="14">
                <!-- Section 1 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                              Fill="#0078D7" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Create &amp; Edit Notes" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click '+ New Note' in the dashboard or use the tray icon context menu. You can drag any note by its title bar."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 2 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                              Fill="#E67E22" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Pin Notes on Top" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the pin button on any note to keep it floating above all other open windows."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 3 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M12,2C6.49,2 2,6.49 2,12C2,17.51 6.49,22 12,22C13.38,22 14.5,20.88 14.5,19.5C14.5,18.86 14.24,18.28 13.82,17.86C13.41,17.45 13.15,16.89 13.15,16.27C13.15,14.9 14.27,13.78 15.64,13.78H18C20.21,13.78 22,11.99 22,9.78C22,5.48 17.52,2 12,2ZM6.5,12C5.67,12 5,11.33 5,10.5C5,9.67 5.67,9 6.5,9C7.33,9 8,9.67 8,10.5C8,11.33 7.33,12 6.5,12ZM9.5,8C8.67,8 8,7.33 8,6.5C8,5.67 8.67,5 9.5,5C10.33,5 11,5.67 11,6.5C11,7.33 10.33,8 9.5,8ZM14.5,8C13.67,8 13,7.33 13,6.5C13,5.67 13.67,5 14.5,5C15.33,5 16,5.67 16,6.5C16,7.33 15.33,8 14.5,8ZM17.5,12C16.67,12 16,11.33 16,10.5C16,9.67 16.67,9 17.5,9C18.33,9 19,9.67 19,10.5C19,11.33 18.33,12 17.5,12Z"
                              Fill="#9B59B6" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Colors &amp; Customization" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Click the palette button to customize note colors, change transparency, or adjust text font sizes."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section 4 -->
                <Border CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#22000000" BorderThickness="1" Padding="14">
                    <Grid ColumnDefinitions="40,*">
                        <Path Grid.Column="0" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                              Fill="#2ECC71" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="System Tray Access" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="PinNote stays in your system tray. Right-click the tray icon anytime to create notes, show/hide all notes, or switch themes."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="0,10,0,0">
            <Button Content="Got it"
                    HorizontalAlignment="Right"
                    Background="#1F6FEB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    CornerRadius="6"
                    Padding="24,8"
                    Click="GotIt_Click"
                    Cursor="Hand" />
        </Border>
    </Grid>
</Window>
