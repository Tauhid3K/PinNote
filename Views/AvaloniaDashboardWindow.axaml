<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PinNote.ViewModels"
        x:Class="PinNote.Views.AvaloniaDashboardWindow"
        x:DataType="vm:MainViewModel"
        Title="PinNote - All Notes"
        Width="780"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="{Binding ShowInTaskbar}">

    <Grid RowDefinitions="56,*">
        <!-- Top Navigation / Search Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="#22000000"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="📌" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="PinNote" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search Box -->
                <TextBox Grid.Column="1"
                         Margin="24,0,16,0"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Search notes..."
                         VerticalAlignment="Center"
                         CornerRadius="6"
                         Height="34" />

                <!-- "+ New Note" Button -->
                <Button Grid.Column="2"
                        Command="{Binding NewNoteCommand}"
                        Background="#1F6FEB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="14,6"
                        Height="34"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="New Note" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Show Instructions -->
                <Button Grid.Column="3"
                        Command="{Binding HelpCommand}"
                        Width="34" Height="34"
                        Padding="0"
                        CornerRadius="6"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Keyboard Shortcuts &amp; Help"
                        Cursor="Hand">
                    <TextBlock Text="?" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Show All Notes -->
                <Button Grid.Column="4"
                        Command="{Binding ShowAllCommand}"
                        Height="34"
                        Padding="12,6"
                        CornerRadius="6"
                        ToolTip.Tip="Show all note windows"
                        Cursor="Hand">
                    <TextBlock Text="Show All" VerticalAlignment="Center" />
                </Button>

                <!-- Settings Button -->
                <Button Grid.Column="5"
                        Width="34" Height="34"
                        Padding="0"
                        CornerRadius="6"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Settings"
                        Cursor="Hand">
                    <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Show Pin Icon in Top Bar"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                            <MenuItem Header="Show in Bottom Bar / Taskbar"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}" />
                            <MenuItem Header="Start on System Boot"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}" />
                            <Separator />
                            <MenuItem Header="Theme">
                                <MenuItem Header="System Theme" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                                <MenuItem Header="Light Theme" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                                <MenuItem Header="Dark Theme" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area: Note Cards -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <ItemsControl ItemsSource="{Binding FilteredNotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoteViewModel">
                        <Border Width="220"
                                Height="180"
                                Margin="8"
                                CornerRadius="8"
                                BorderBrush="#33000000"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                PointerPressed="NoteCard_PointerPressed"
                                Background="{Binding BodyColor}">
                            <Grid RowDefinitions="36,*,32">
                                <!-- Card Header -->
                                <Border Grid.Row="0"
                                        Background="{Binding TitleBarColor}"
                                        Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding CardTextColor}" />

                                        <!-- Duplicate -->
                                        <Button Grid.Column="1"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DuplicateCommand}"
                                                ToolTip.Tip="Duplicate"
                                                Margin="0,0,2,0">
                                            <TextBlock Text="📄" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Grid.Column="2"
                                                Width="24" Height="24"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip.Tip="Delete">
                                            <TextBlock Text="🗑️" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Card Preview Body -->
                                <TextBlock Grid.Row="1"
                                           Margin="10,8"
                                           Text="{Binding PlainTextPreview}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12"
                                           Foreground="{Binding CardTextColor}"
                                           Opacity="0.85" />

                                <!-- Card Footer -->
                                <Border Grid.Row="2"
                                        Padding="10,0"
                                        Background="#11000000">
                                    <TextBlock Text="Click to open note"
                                               FontSize="11"
                                               Foreground="{Binding CardTextColor}"
                                               Opacity="0.6"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
