<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PinNote.ViewModels"
        x:Class="PinNote.Views.AvaloniaDashboardWindow"
        x:DataType="vm:MainViewModel"
        Title="PinNote - All Notes"
        Width="780"
        Height="540"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="{Binding ShowInTaskbar}">

    <Window.Styles>
        <Style Selector="Button.card-action-btn">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#18000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33000000" />
        </Style>
        <Style Selector="Button.card-delete-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFE5534B" />
        </Style>
        <Style Selector="Button.card-delete-btn:pointerover Path">
            <Setter Property="Fill" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="56,*">
        <!-- Top Navigation / Search Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="#22000000"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z"
                          Fill="#1F6FEB" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="PinNote" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Search Box -->
                <TextBox Grid.Column="1"
                         Margin="24,0,16,0"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         Watermark="Search notes..."
                         VerticalAlignment="Center"
                         CornerRadius="6"
                         Height="34" />

                <!-- "+ New Note" Button -->
                <Button Grid.Column="2"
                        Command="{Binding NewNoteCommand}"
                        Background="#1F6FEB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="14,6"
                        Height="34"
                        Margin="0,0,8,0"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="New Note" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Show Instructions -->
                <Button Grid.Column="3"
                        Command="{Binding HelpCommand}"
                        Width="34" Height="34"
                        Padding="0"
                        CornerRadius="6"
                        Margin="0,0,8,0"
                        ToolTip.Tip="Keyboard Shortcuts &amp; Help"
                        Cursor="Hand">
                    <TextBlock Text="?" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Show All Notes -->
                <Button Grid.Column="4"
                        Command="{Binding ShowAllCommand}"
                        Height="34"
                        Padding="12,6"
                        CornerRadius="6"
                        ToolTip.Tip="Show all note windows"
                        Cursor="Hand">
                    <TextBlock Text="Show All" VerticalAlignment="Center" />
                </Button>

                <!-- Settings Button -->
                <Button Grid.Column="5"
                        Width="34" Height="34"
                        Padding="0"
                        CornerRadius="6"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Settings"
                        Cursor="Hand">
                    <Path Data="M19.14,12.94C19.18,12.63 19.2,12.32 19.2,12C19.2,11.68 19.18,11.37 19.14,11.06L21.41,9.29C21.62,9.13 21.68,8.83 21.54,8.6L19.4,4.89C19.26,4.66 18.98,4.57 18.74,4.66L16.07,5.74C15.52,5.31 14.91,4.96 14.25,4.69L13.85,1.85C13.81,1.6 13.6,1.41 13.34,1.41H9.06C8.8,1.41 8.59,1.6 8.55,1.85L8.15,4.69C7.49,4.96 6.88,5.31 6.33,5.74L3.66,4.66C3.42,4.57 3.14,4.66 3,4.89L0.86,8.6C0.72,8.83 0.78,9.13 0.99,9.29L3.26,11.06C3.22,11.37 3.2,11.68 3.2,12C3.2,12.32 3.22,12.63 3.26,12.94L0.99,14.71C0.78,14.87 0.72,15.17 0.86,15.4L3,19.11C3.14,19.34 3.42,19.43 3.66,19.34L6.33,18.26C6.88,18.69 7.49,19.04 8.15,19.31L8.55,22.15C8.59,22.4 8.8,22.59 9.06,22.59H13.34C13.6,22.59 13.81,22.4 13.85,22.15L14.25,19.31C14.91,19.04 15.52,18.69 16.07,18.26L18.74,19.34C18.98,19.43 19.26,19.34 19.4,19.11L21.54,15.4C21.68,15.17 21.62,14.87 21.41,14.71L19.14,12.94ZM11.2,15.6C9.21,15.6 7.6,13.99 7.6,12C7.6,10.01 9.21,8.4 11.2,8.4C13.19,8.4 14.8,10.01 14.8,12C14.8,13.99 13.19,15.6 11.2,15.6Z"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Width="15" Height="15" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Import Notes..." Command="{Binding ImportNotesCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M19,9h-4V3H9v6H5l7,7 7,-7zM5,18v2h14v-2H5z"
                                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Width="12" Height="12" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Export Notes..." Command="{Binding ExportNotesCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M9,16h6v-6h4l-7,-7 -7,7h4v6zm-4,2h14v2H5v-2z"
                                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Width="12" Height="12" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Create Backup" Command="{Binding BackupNotesCommand}">
                                <MenuItem.Icon>
                                    <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                          Width="12" Height="12" Stretch="Uniform" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Show Pin Icon in Top Bar"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}" />
                            <MenuItem Header="Show in Bottom Bar / Taskbar"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowInTaskbar, Mode=TwoWay}" />
                            <MenuItem Header="Start on System Boot"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}" />
                            <Separator />
                            <MenuItem Header="Theme">
                                <MenuItem Header="System Theme" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                                <MenuItem Header="Light Theme" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                                <MenuItem Header="Dark Theme" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Sort Notes">
                                <MenuItem Header="Default order"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="Default" />
                                <MenuItem Header="Title A → Z"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="TitleAscending" />
                                <MenuItem Header="Title Z → A"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="TitleDescending" />
                                <MenuItem Header="Last modified (newest first)"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="ModifiedNewest" />
                                <MenuItem Header="Last modified (oldest first)"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="ModifiedOldest" />
                                <MenuItem Header="Date created (newest first)"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="CreatedNewest" />
                                <MenuItem Header="Date created (oldest first)"
                                          Command="{Binding SetSortModeCommand}"
                                          CommandParameter="CreatedOldest" />
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area: Note Cards -->
        <ScrollViewer Grid.Row="1" Padding="16">
            <ItemsControl ItemsSource="{Binding SortedFilteredNotes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoteViewModel">
                        <Border Width="220"
                                Height="180"
                                Margin="8"
                                CornerRadius="8"
                                BorderBrush="#33000000"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                PointerPressed="NoteCard_PointerPressed"
                                Background="{Binding BodyColor}">
                            <Grid RowDefinitions="36,*,32">
                                <!-- Card Header -->
                                <Border Grid.Row="0"
                                        Background="{Binding TitleBarColor}"
                                        Padding="10,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding CardHeaderTextColor}" />

                                        <!-- Duplicate -->
                                        <Button Grid.Column="1"
                                                Classes="card-action-btn"
                                                Command="{Binding DuplicateCommand}"
                                                ToolTip.Tip="Duplicate"
                                                Margin="0,0,4,0">
                                            <Path Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1ZM19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5ZM19,21H8V7H19V21Z"
                                                  Fill="{Binding CardHeaderTextColor}"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Grid.Column="2"
                                                Classes="card-action-btn card-delete-btn"
                                                Command="{Binding DeleteCommand}"
                                                ToolTip.Tip="Delete">
                                            <Path Data="M6,19C6,20.1 6.9,21 8,21H16C17.1,21 18,20.1 18,19V7H6V19ZM19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4Z"
                                                  Fill="#E5534B"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Card Preview Body -->
                                <TextBlock Grid.Row="1"
                                           Margin="10,8"
                                           Text="{Binding PlainTextPreview}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12"
                                           Foreground="{Binding CardBodyTextColor}"
                                           Opacity="0.85" />

                                <!-- Card Footer -->
                                <Border Grid.Row="2"
                                        Padding="10,0"
                                        Background="#11000000">
                                    <TextBlock Text="Click to open note"
                                               FontSize="11"
                                               Foreground="{Binding CardBodyTextColor}"
                                               Opacity="0.6"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
