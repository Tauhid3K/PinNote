<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme resources -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#F9F9F9" />
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#333333" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666" />
  <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#F3F3F3" />
  <SolidColorBrush x:Key="NoteCardBorderBrush" Color="#16000000" />
  <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#E0E0E0" />
  <SolidColorBrush x:Key="PrimaryButtonBackground" Color="#0078D4" />
  <SolidColorBrush x:Key="PrimaryButtonHover" Color="#106EBE" />
  <SolidColorBrush x:Key="PrimaryButtonPressed" Color="#005A9E" />
  <!-- Instructions window specific brushes -->
  <SolidColorBrush x:Key="SectionCardBackgroundBrush" Color="#F8F9FA" />
  <SolidColorBrush x:Key="SectionCardBorderBrush" Color="#E1E4E8" />
  <SolidColorBrush x:Key="ActionChipBackground" Color="#F1F3F5" />
  <SolidColorBrush x:Key="ActionChipBorderBrush" Color="#D0D7DE" />
  <SolidColorBrush x:Key="IconOnColorBrush" Color="#0078D4" />
  <SolidColorBrush x:Key="IconCircleDefaultBackgroundBrush" Color="#F3F4F6" />
</ResourceDictionary>
