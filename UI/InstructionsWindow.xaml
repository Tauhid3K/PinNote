<Window x:Class="PinNote.UI.InstructionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PinNote Instructions" Height="780" Width="700"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    WindowStartupLocation="CenterScreen" Topmost="True"
    ShowInTaskbar="False" Foreground="{DynamicResource PrimaryTextBrush}"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource SectionCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SectionCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Background" Value="{DynamicResource IconCircleDefaultBackgroundBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ActionChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="{DynamicResource ActionChipBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource SectionCardBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="Black" Opacity="0.18" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18,18,0,0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PrimaryButtonBackground}" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to PinNote" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Follow the quick tour below to create, pin, move, and style notes" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click" Padding="8,4" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="18,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="54" Height="54" CornerRadius="27" Background="#1F6FEB" VerticalAlignment="Top">
                                <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Quick start" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="PinNote is designed to stay out of your way. Start with a note, pin what matters, and keep the dashboard in the tray when you are done." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />

                                <WrapPanel Margin="0,12,0,0">
                                    <Border Style="{StaticResource ActionChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconOnColorBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="New note" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ActionChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconOnColorBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="Pin note" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource ActionChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconOnColorBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="Tray menu" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                            <TextBlock Text="Do these four things first" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource PrimaryTextBrush}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource IconCircle}" Background="#E8F5E9" Margin="44,0,12,0">
                                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Create a note" FontWeight="SemiBold" />
                                    <TextBlock Text="Open the tray menu and choose New note, or click the New note button on the dashboard. This is where every new note begins." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource IconCircle}" Background="#FFF4E5" Margin="44,0,12,0">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#C56A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Move and resize" FontWeight="SemiBold" />
                                    <TextBlock Text="Drag the note title bar to move it. Use any edge or corner to resize it until it fits your workspace." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource IconCircle}" Background="#EAF2FF" Margin="44,0,12,0">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#1F6FEB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pin important notes" FontWeight="SemiBold" />
                                    <TextBlock Text="Right-click a note and turn on Always on top when you want it to stay visible above other windows." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="4" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Style="{StaticResource IconCircle}" Background="#FCE8E6" Margin="44,0,12,0">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Remove a note safely" FontWeight="SemiBold" />
                                    <TextBlock Text="Use the note menu or dashboard delete action. PinNote will always ask before removing anything." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Customize with confidence" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}" />

                            <Expander Header="Colors and appearance" IsExpanded="True">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="1. Right-click a note and choose Color." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="2. Select More colors... to open the standard Windows color picker." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="3. Pick a color, press OK, and the note updates immediately." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="4. Any custom swatches you add in that dialog will be available next time." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Crystal Clear mode">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="Turn on Crystal clear from the note menu to make the background transparent." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="Use it when you want a minimal overlay note. The text stays readable by using your selected note color." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Themes">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="Use the Light and Dark buttons in the dashboard title bar to switch themes." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="Use System from the tray menu if you want PinNote to follow the Windows theme automatically." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Useful shortcuts" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Use these while editing note text." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle bold text" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + I" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle italic text" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + U" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle underline" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconCircle}" Background="#EDE7F6">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#6A4FB3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dashboard and tray" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="Close the dashboard to keep PinNote in the tray. Right-click the tray icon for New note, Show all notes, Hide all notes, Bring notes on top, Theme, and Exit." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBackgroundBrush}" CornerRadius="0,0,18,18" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource IconOnColorBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tip: Use the tray icon when you want PinNote to stay running without the dashboard open." 
                                   TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="Got it" Padding="18,8" Margin="16,0,0,0"
                            Background="{DynamicResource PrimaryButtonBackground}" Foreground="White" FontWeight="SemiBold"
                            HorizontalAlignment="Right" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>