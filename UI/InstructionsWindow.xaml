<Window x:Class="PinNote.UI.InstructionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote Instructions" Height="450" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#DDD">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.2" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,10">
                    <TextBlock Text="Getting Started" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click" Padding="5" />
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Welcome to PinNote" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryButtonBackground}" />

                    <TextBlock Text="The Essentials" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Resizing: Grab any edge or corner to scale notes." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Moving: Drag the title bar or the options area." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Always on Top: Right-click a note and toggle 'Always on top'." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Delete: Use the delete action from the note menu or dashboard. You will be asked to confirm before a note is removed." Margin="5,0,0,3" TextWrapping="Wrap" />

                    <TextBlock Text="Color &amp; Appearance" FontWeight="Bold" FontSize="14" Margin="12,8,0,5" />
                    <TextBlock Text="• Color: Right-click a note → Color → More colors... opens the system color picker." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Custom swatches: If you use 'Add to Custom Colors' inside the color picker and then press OK, that custom swatch is saved and will appear next time you open the color dialog." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Crystal Clear: Toggle 'Crystal clear' in the note menu to make the note background transparent. Text will use the selected note color." Margin="5,0,0,15" TextWrapping="Wrap" />

                    <TextBlock Text="Themes" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Dashboard themes: Use the Light and Dark buttons in the dashboard title bar to switch themes." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• System theme: The System option is available from the system tray menu and follows your Windows color preference." Margin="5,0,0,15" TextWrapping="Wrap" />

                    <TextBlock Text="Minimize &amp; System Tray" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Minimize: Hides the dashboard to the system tray (bottom right). Use the tray icon to restore." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Tray menu: Right-click the tray icon for New note, Show all, Hide all, Bring on top, Theme, Exit." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• First run: If this is your first time, the app may show the welcome/instructions automatically." Margin="5,0,0,15" TextWrapping="Wrap" />

                    <TextBlock Text="Keyboard Shortcuts" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <Grid Margin="5,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ctrl + B" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Bold" Grid.Row="0" Grid.Column="1" />

                        <TextBlock Text="Ctrl + I" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Italic" Grid.Row="1" Grid.Column="1" />

                        <TextBlock Text="Ctrl + U" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Underline" Grid.Row="2" Grid.Column="1" />
                    </Grid>

                    <TextBlock Text="Smart Features" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Auto-Startup: Use 'Start with Windows' on the dashboard to have your notes restored on login." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Smart Search: Filter notes from the dashboard instantly using the search box." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Auto-Save: Notes are saved automatically when you type or move them." Margin="5,0,0,15" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Button Grid.Row="2" Content="Got it" Margin="20" Padding="20,8"
                    Background="{DynamicResource PrimaryButtonBackground}" Foreground="White" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Click="Close_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>