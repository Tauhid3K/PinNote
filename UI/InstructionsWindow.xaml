<Window x:Class="PinNote.UI.InstructionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote Instructions" Height="450" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False">
    
    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="#DDD">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.2" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,10">
                    <TextBlock Text="Getting Started" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" 
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click" Padding="5" />
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Welcome to PinNote" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" Foreground="{DynamicResource PrimaryButtonBackground}" />
                    
                    <TextBlock Text="The Essentials" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Resizing: Grab any edge or corner to scale notes." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Moving: Drag the title bar or the options area." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Always on Top: Right-click a note to pin it." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Customization: Right-click for colors, opacity, and text size." Margin="5,0,0,15" TextWrapping="Wrap" />

                    <TextBlock Text="Minimize &amp; System Tray" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Minimize: Hides the dashboard to the system tray (bottom right corner)." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Tray Icon: Left-click the tray icon to quickly restore your dashboard." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Exiting: Clicking 'X' will prompt to close the entire app safely." Margin="5,0,0,15" TextWrapping="Wrap" />

                    <TextBlock Text="Professional Shortcuts" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <Grid Margin="5,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Ctrl + B" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Bold" Grid.Row="0" Grid.Column="1" />
                        
                        <TextBlock Text="Ctrl + I" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Italic" Grid.Row="1" Grid.Column="1" />
                        
                        <TextBlock Text="Ctrl + U" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0" Margin="0,0,15,3" />
                        <TextBlock Text="Toggle Underline" Grid.Row="2" Grid.Column="1" />
                    </Grid>

                    <TextBlock Text="Smart Features" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />
                    <TextBlock Text="• Auto-Startup: Use 'Start with Windows' on the dashboard to have your notes ready on boot." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Smart Search: Instantly filter through dozens of notes from the dashboard." Margin="5,0,0,3" TextWrapping="Wrap" />
                    <TextBlock Text="• Auto-Save: Every letter you type and every move you make is saved instantly." Margin="5,0,0,15" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
                    <Button Grid.Row="2" Content="Got it" Margin="20" Padding="20,8"
                    Background="{DynamicResource PrimaryButtonBackground}" Foreground="White" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Click="Close_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#106EBE" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>