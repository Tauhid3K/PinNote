<Window x:Class="PinNote.UI.InstructionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinNote Instructions" Height="720" Width="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#D8DEE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="IconCircle" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="18" BorderThickness="1" BorderBrush="#DDE3EA">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="Black" Opacity="0.18" ShadowDepth="0" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18,18,0,0" Background="{DynamicResource TitleBarBackgroundBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="18" Background="#1F6FEB" VerticalAlignment="Center">
                        <TextBlock Text="📝" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to PinNote" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="A quick guide to get you moving in under a minute" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="✕" FontFamily="Segoe UI Emoji"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="Close_Click" Padding="8,4" FontSize="14" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="18,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Start here" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconCircle}" Background="#E8F5E9">
                                    <TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Create or open a note" FontWeight="SemiBold" />
                                    <TextBlock Text="Use New note from the tray menu or the dashboard to start a fresh note." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconCircle}" Background="#FFF4E5">
                                    <TextBlock Text="↔" FontSize="18" FontWeight="Bold" Foreground="#C56A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Move and resize easily" FontWeight="SemiBold" />
                                    <TextBlock Text="Drag the note title bar to move it. Grab any edge or corner to resize it." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconCircle}" Background="#EAF2FF">
                                    <TextBlock Text="📌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Pin important notes" FontWeight="SemiBold" />
                                    <TextBlock Text="Right-click a note and turn on Always on top when you want it to stay visible." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconCircle}" Background="#FCE8E6">
                                    <TextBlock Text="🗑" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Remove a note safely" FontWeight="SemiBold" />
                                    <TextBlock Text="Use the note menu or dashboard delete action. PinNote will ask before removing anything." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Make it yours" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                            <Expander Header="Colors and appearance" IsExpanded="True">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="• Right-click a note, choose Color, then More colors... to open the system color picker." TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="• Pick a color and press OK to apply it immediately." TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="• Custom swatches you add in the color dialog are saved and reappear later." TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Crystal Clear mode">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="Turn on Crystal clear from the note menu to make the background transparent." TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="When it is on, the note text uses the selected note color, so the note stays readable." TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Themes">
                                <StackPanel Margin="8,10,0,0">
                                    <TextBlock Text="Use the Light and Dark buttons in the dashboard title bar to switch themes." TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="System theme is available from the tray menu and follows your Windows setting." TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="Useful shortcuts" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + B" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle bold text" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + I" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle italic text" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ctrl + U" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Toggle underline" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconCircle}" Background="#EDE7F6">
                                <TextBlock Text="🪟" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Dashboard and tray" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="Close the dashboard to keep PinNote in the tray. Right-click the tray icon for New note, Show all notes, Hide all notes, Bring notes on top, Theme, and Exit." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBackgroundBrush}" CornerRadius="0,0,18,18" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tip: Use the tray icon when you want PinNote to stay running without the dashboard open." 
                               TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />

                    <Button Grid.Column="1" Content="Got it" Padding="18,8" Margin="16,0,0,0"
                            Background="{DynamicResource PrimaryButtonBackground}" Foreground="White" FontWeight="SemiBold"
                            HorizontalAlignment="Right" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#106EBE" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>