<Window x:Class="PinNote.UI.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinNote.UI"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="{Binding Height, Mode=TwoWay}"
        Width="{Binding Width, Mode=TwoWay}"
        Left="{Binding X, Mode=TwoWay}"
        Top="{Binding Y, Mode=TwoWay}"
        MinWidth="100"
        MinHeight="100"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="{Binding Opacity, Mode=TwoWay}"
        Topmost="{Binding IsPinned}"
        ShowInTaskbar="False"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <local:BooleanToPinTextConverter x:Key="BooleanToPinTextConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="NoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#220078D4" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#330078D4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource NoteButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="2"
            BorderBrush="#55000000"
            BorderThickness="1"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding BodyColor}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCrystalClear}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Color="Black" Opacity="0.16" ShadowDepth="3" />
        </Border.Effect>

        <Grid>
            <Grid.ContextMenu>
                <ContextMenu x:Name="NoteMenu"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Always on top"
                              IsCheckable="True"
                              IsChecked="{Binding IsPinned, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Checklist mode"
                              Command="{Binding ToggleNoteTypeCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Markdown mode"
                              IsCheckable="True"
                              IsChecked="{Binding IsMarkdown, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <TextBlock Text="MD" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Category">
                        <MenuItem Header="None" Command="{Binding SetCategoryCommand}" CommandParameter="" />
                        <MenuItem Header="Study" Command="{Binding SetCategoryCommand}" CommandParameter="Study" />
                        <MenuItem Header="Personal" Command="{Binding SetCategoryCommand}" CommandParameter="Personal" />
                        <MenuItem Header="Work" Command="{Binding SetCategoryCommand}" CommandParameter="Work" />
                        <MenuItem Header="Projects" Command="{Binding SetCategoryCommand}" CommandParameter="Projects" />
                    </MenuItem>
                    <MenuItem Header="Workspace">
                        <MenuItem Header="Default" Command="{Binding SetWorkspaceCommand}" CommandParameter="Default" />
                        <MenuItem Header="University" Command="{Binding SetWorkspaceCommand}" CommandParameter="University" />
                        <MenuItem Header="Personal" Command="{Binding SetWorkspaceCommand}" CommandParameter="Personal" />
                        <MenuItem Header="Development" Command="{Binding SetWorkspaceCommand}" CommandParameter="Development" />
                        <MenuItem Header="Projects" Command="{Binding SetWorkspaceCommand}" CommandParameter="Projects" />
                    </MenuItem>
                    <MenuItem Header="Reminder">
                        <MenuItem Header="In 1 Hour" Command="{Binding SetReminder1HourCommand}" />
                        <MenuItem Header="Today Evening (6 PM)" Command="{Binding SetReminderTodayEveningCommand}" />
                        <MenuItem Header="Tomorrow Morning (9 AM)" Command="{Binding SetReminderTomorrowMorningCommand}" />
                        <MenuItem Header="Next Week" Command="{Binding SetReminderNextWeekCommand}" />
                        <Separator />
                        <MenuItem Header="Clear Reminder" Command="{Binding ClearReminderCommand}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Color">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <ItemsControl x:Name="ColorPalette">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Width>168</ItemsControl.Width>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22"
                                            Height="22"
                                            Padding="0"
                                            BorderThickness="1"
                                            BorderBrush="#80000000"
                                            Background="{Binding Color}"
                                            ToolTip="{Binding Name}"
                                            Command="{Binding DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                            CommandParameter="{Binding CommandParam}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="3" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#FF000000" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator />
                        <MenuItem Header="More colors..." Click="MoreColors_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Transparency">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem Header="100%" Command="{Binding SetOpacityCommand}" CommandParameter="1.0" />
                        <MenuItem Header="90%" Command="{Binding SetOpacityCommand}" CommandParameter="0.9" />
                        <MenuItem Header="80%" Command="{Binding SetOpacityCommand}" CommandParameter="0.8" />
                        <MenuItem Header="70%" Command="{Binding SetOpacityCommand}" CommandParameter="0.7" />
                        <MenuItem Header="60%" Command="{Binding SetOpacityCommand}" CommandParameter="0.6" />
                        <MenuItem Header="50%" Command="{Binding SetOpacityCommand}" CommandParameter="0.5" />
                    </MenuItem>
                    <MenuItem Header="Text Size">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem Header="Extra Small" Command="{Binding SetFontSizeCommand}" CommandParameter="12|12" />
                        <MenuItem Header="Small" Command="{Binding SetFontSizeCommand}" CommandParameter="16|16" />
                        <MenuItem Header="Normal" Command="{Binding SetFontSizeCommand}" CommandParameter="20|20" />
                        <MenuItem Header="Large" Command="{Binding SetFontSizeCommand}" CommandParameter="24|24" />
                        <MenuItem Header="Extra Large" Command="{Binding SetFontSizeCommand}" CommandParameter="28|28" />
                    </MenuItem>
                    <MenuItem Header="Crystal clear" IsCheckable="True" IsChecked="{Binding IsCrystalClear, Mode=TwoWay}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                        <MenuItem.ToolTip>
                            Shows only white text on a transparent note background.
                        </MenuItem.ToolTip>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Delete note" Command="{Binding DeleteCommand}" Foreground="#CC0000">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#CC0000" VerticalAlignment="Center" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid.RowDefinitions>
                <RowDefinition x:Name="OptionsRow" Height="28" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FormattingRow" Height="34" />
            </Grid.RowDefinitions>

            <Border x:Name="OptionsBar"
                    Grid.Row="0"
                    Background="{Binding ActiveTitleBarColor}"
                    BorderBrush="#33000000"
                    BorderThickness="0,0,0,1"
                    PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Grab area -->
                        <Border Grid.Column="0" Background="Transparent" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Button Content="+"
                                    Style="{StaticResource NoteButtonStyle}"
                                    Command="{Binding NewNoteCommand}"
                                    ToolTip="New note" />
                            <Button Content="{Binding IsPinned, Converter={StaticResource BooleanToPinTextConverter}}"
                                    Style="{StaticResource NoteButtonStyle}"
                                    FontSize="11"
                                    Command="{Binding TogglePinCommand}"
                                    ToolTip="Pin note on top" />
                            <Button x:Name="SettingsButton"
                                    Content="&#xE712;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource NoteButtonStyle}"
                                    Click="Settings_Click"
                                    ToolTip="Options" />
                            <Button Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource NoteButtonStyle}"
                                    Click="CloseNote_Click"
                                    ToolTip="Close note" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="#33000000"
                    BorderThickness="0,0,0,1"
                    PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding BodyColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCrystalClear}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,3,10,4"
                         MinHeight="26"
                         HorizontalContentAlignment="Center"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         FontSize="{Binding TitleFontSize}"
                         FontFamily="Segoe UI"
                         FontWeight="Bold"
                         Foreground="{Binding TextBrush}"
                         CaretBrush="{Binding TextBrush}"
                         ToolTip="Edit note title" />
            </Border>

            <!-- Row 2: Metadata Strip -->
            <Border Grid.Row="2"
                    BorderBrush="#33000000"
                    BorderThickness="0,0,0,1"
                    Padding="8,2"
                    Visibility="{Binding HasMetadata, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding BodyColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCrystalClear}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel VerticalAlignment="Center">
                    <!-- Category Badge -->
                    <Border Background="#22000000" CornerRadius="3" Padding="4,1" Margin="0,0,4,2"
                            Visibility="{Binding Category, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding TextBrush}" />
                    </Border>

                    <!-- Workspace Badge -->
                    <Border Background="#22000000" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                        <TextBlock Text="{Binding WorkspaceName}" FontSize="10" Foreground="{Binding TextBrush}" />
                    </Border>

                    <!-- Reminder Badge -->
                    <Border Background="#33FF9800" CornerRadius="3" Padding="4,1" Margin="0,0,4,2"
                            Visibility="{Binding HasReminder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource NoteButtonStyle}" Height="16" MinWidth="0" Padding="2,0"
                                Command="{Binding ClearReminderCommand}" ToolTip="Click to clear reminder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏰ " FontSize="9" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReminderSummary}" FontSize="10" Foreground="{Binding TextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text=" ×" FontSize="10" FontWeight="Bold" Foreground="{Binding TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Markdown Mode Toggle Badge -->
                    <Button Style="{StaticResource NoteButtonStyle}" Height="18" MinWidth="0" Padding="4,0" Margin="0,0,4,2"
                            Command="{Binding ToggleMarkdownPreviewCommand}"
                            Visibility="{Binding IsMarkdown, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Toggle between Markdown Edit and Preview (Ctrl+M)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MD " FontWeight="Bold" FontSize="10" Foreground="{Binding TextBrush}" />
                            <TextBlock Text="{Binding MarkdownModeText}" FontSize="10" Foreground="{Binding TextBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Tags -->
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22000000" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="#" FontSize="9" Opacity="0.7" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Style="{StaticResource NoteButtonStyle}" Height="14" MinWidth="0" Padding="2,0" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Remove tag">
                                            <TextBlock Text="×" FontSize="10" FontWeight="Bold" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Border>

            <!-- Row 3: Note Content Area -->
            <!-- RichText / Markdown Editor -->
            <RichTextBox x:Name="EditorBox"
                         Grid.Row="3"
                         Foreground="{Binding TextBrush}"
                         BorderThickness="0"
                         Padding="10,8,10,10"
                         FontSize="{Binding BodyFontSize}"
                         FontFamily="Segoe UI"
                         CaretBrush="{Binding TextBrush}"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Note content"
                         AcceptsTab="True">
                <RichTextBox.Style>
                    <Style TargetType="RichTextBox">
                        <Setter Property="Background" Value="{Binding BodyColor}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCrystalClear}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecklist}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMarkdownPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RichTextBox.Style>
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="LineHeight" Value="24" />
                    </Style>
                    <Style TargetType="List">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>

            <!-- Markdown Rendered Preview View -->
            <ScrollViewer Grid.Row="3"
                          Margin="10,8,10,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMarkdownPreviewMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding MarkdownBlocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <!-- Heading 1 -->
                                <TextBlock Text="{Binding Text}" FontSize="18" FontWeight="Bold" Margin="0,6,0,2"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading1}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Heading 2 -->
                                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,2"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading2}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Heading 3 -->
                                <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,1"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeading3}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Paragraph -->
                                <TextBlock Text="{Binding Text}" FontSize="{Binding DataContext.BodyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsParagraph}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Bullet -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBullet}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="• " FontSize="14" FontWeight="Bold" Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding Text}" FontSize="{Binding DataContext.BodyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Checklist -->
                                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="False" Margin="0,1">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecklist}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                    <TextBlock Text="{Binding Text}" FontSize="{Binding DataContext.BodyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                                </CheckBox>
                                <!-- Quote -->
                                <Border BorderBrush="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                        BorderThickness="3,0,0,0" Padding="8,2" Margin="0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuote}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" FontStyle="Italic"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                                </Border>
                                <!-- Code Block -->
                                <Border Background="#22000000" CornerRadius="4" Padding="8,6" Margin="0,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas,Courier New" FontSize="11"
                                               Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Checklist View -->
            <ScrollViewer Grid.Row="3"
                          Margin="8,4"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecklist}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ChecklistItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              AutomationProperties.Name="Checklist item status" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             KeyDown="ChecklistItem_KeyDown"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Checklist item text"
                                             Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CaretBrush="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                             FontSize="{Binding DataContext.BodyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Button Grid.Column="2"
                                            Content="&#xE70E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            Command="{Binding MoveUpCommand}"
                                            Width="20" Height="20"
                                            ToolTip="Move up"
                                            AutomationProperties.Name="Move checklist item up" />
                                    <Button Grid.Column="3"
                                            Content="&#xE70D;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            Command="{Binding MoveDownCommand}"
                                            Width="20" Height="20"
                                            ToolTip="Move down"
                                            AutomationProperties.Name="Move checklist item down" />
                                    <Button Grid.Column="4"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Style="{StaticResource ToolbarIconButtonStyle}"
                                            Command="{Binding DeleteCommand}"
                                            Width="20" Height="20"
                                            Foreground="#CC0000"
                                            ToolTip="Delete item"
                                            AutomationProperties.Name="Delete checklist item" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add item"
                            Style="{StaticResource NoteButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Padding="8,2"
                            Height="24"
                            FontSize="12"
                            Command="{Binding AddChecklistItemCommand}"
                            ToolTip="Add new checklist item"
                            AutomationProperties.Name="Add checklist item" />
                </StackPanel>
            </ScrollViewer>

            <!-- Row 4: Formatting Bar -->
            <Border x:Name="FormattingBar"
                    Grid.Row="4"
                    Background="{Binding ActiveTitleBarColor}"
                    BorderBrush="#33000000"
                    BorderThickness="0,1,0,1"
                    Padding="4,5">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="B" Style="{StaticResource ToolbarButtonStyle}" FontWeight="Bold" ToolTip="Bold (Ctrl+B)" Click="BoldButton_Click" AutomationProperties.Name="Bold" />
                        <Button Grid.Column="1" Content="I" Style="{StaticResource ToolbarButtonStyle}" FontStyle="Italic" ToolTip="Italic (Ctrl+I)" Click="ItalicButton_Click" AutomationProperties.Name="Italic" />
                        <Button Grid.Column="2" Content="U" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Underline (Ctrl+U)" Click="UnderlineButton_Click" AutomationProperties.Name="Underline">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="U" TextDecorations="Underline" />
                                    </DataTemplate>
                                </Button.ContentTemplate>
                        </Button>
                        <Rectangle Grid.Column="3" Width="1" Height="20" Fill="#33000000" HorizontalAlignment="Center" />
                        <Button Grid.Column="4" Content="&#xE8FD;" Style="{StaticResource ToolbarIconButtonStyle}" ToolTip="Bulleted list" Click="BulletsButton_Click" AutomationProperties.Name="Bullet list" />
                        <Button Grid.Column="5"
                                Content="&#xE91B;"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="Add image"
                                Click="ImageButton_Click"
                                AutomationProperties.Name="Insert image" />
                        <Button Grid.Column="6"
                                Content="&#xE73A;"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="Toggle checklist"
                                Command="{Binding ToggleNoteTypeCommand}"
                                AutomationProperties.Name="Toggle checklist mode" />
                        <Button Grid.Column="7"
                                Content="MD"
                                Style="{StaticResource ToolbarButtonStyle}"
                                FontWeight="Bold"
                                FontSize="11"
                                ToolTip="Toggle markdown mode"
                                Command="{Binding ToggleMarkdownModeCommand}"
                                AutomationProperties.Name="Toggle markdown mode" />
                        <Button Grid.Column="8"
                                Content="&#xE890;"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTip="Toggle markdown preview (Ctrl+M)"
                                Command="{Binding ToggleMarkdownPreviewCommand}"
                                AutomationProperties.Name="Toggle markdown preview" />
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Resize Handles Layer -->
            <!-- Edges -->
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" Width="6" Cursor="SizeWE" Tag="Left" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Tag="Right" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" VerticalAlignment="Top" Height="6" Cursor="SizeNS" Tag="Top" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS" Tag="Bottom" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            
            <!-- Corners -->
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10" Cursor="SizeNWSE" Tag="TopLeft" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Cursor="SizeNESW" Tag="TopRight" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="10" Height="10" Cursor="SizeNESW" Tag="BottomLeft" DragDelta="ResizeThumb_DragDelta" Style="{StaticResource ResizeThumbStyle}" />
            <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20" Cursor="SizeNWSE" Tag="BottomRight" DragDelta="ResizeThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Path Data="M 12 18 L 18 18 L 18 12 M 7 18 L 18 18 L 18 7"
                                  Stroke="#44000000"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,4,4" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
