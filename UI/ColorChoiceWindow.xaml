<Window x:Class="PinNote.UI.ColorChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Action" Height="140" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Color selected. What would you like to do?" FontSize="14" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,12">
            <Button x:Name="ApplyButton" Content="Apply" Width="100" Margin="6" />
            <Button x:Name="ApplyAddButton" Content="Apply + Add to palette" Width="160" Margin="6" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="6" />
        </StackPanel>
    </Grid>
</Window>
