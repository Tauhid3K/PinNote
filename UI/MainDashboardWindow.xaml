<Window x:Class="PinNote.UI.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinNote.UI"
        mc:Ignorable="d"
        Title="PinNote - All Notes"
        Height="500"
        Width="800"
        MinWidth="500"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <local:StripTagsConverter x:Key="StripTagsConverter" />
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <local:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.15" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PinNote" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text=" - My Notes" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" Margin="5,0,0,0" />
                        <Button Command="{Binding OpenUpdateCommand}"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                Background="#238636"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Cursor="Hand"
                                ToolTip="New update available! Click to download."
                                AutomationProperties.Name="Update available notification"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔 " />
                                <TextBlock Text="{Binding UpdateBadgeText}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <!-- System theme button removed from main window; kept in tray menu -->
                            <Button Tag="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" ToolTip="Light theme" FontFamily="Segoe MDL2 Assets" Content="&#xE706;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                                                <Setter Property="Background" Value="#11000000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Tag="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" ToolTip="Dark theme" FontFamily="Segoe MDL2 Assets" Content="&#xE708;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="Dark">
                                                <Setter Property="Background" Value="#11000000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Button Content="&#xE946;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Command="{Binding HelpCommand}"
                                ToolTip="Instructions" />
                        <Button Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click"
                                ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton"
                                Content="&#xE922;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Maximize_Click"
                                ToolTip="Maximize" />
                        <Button Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Close_Click"
                                ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                <StackPanel Margin="15,8">
                    <!-- Top Action Bar -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="+ New Note"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewNoteCommand}"
                                AutomationProperties.Name="Create new note" />

                        <Border Grid.Column="1" Background="{DynamicResource SearchBackgroundBrush}" CornerRadius="4" Margin="20,0" Height="36" BorderBrush="{DynamicResource SearchBoxBorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="SearchBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         Margin="8,0"
                                         Padding="0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         SelectionBrush="{DynamicResource PrimaryButtonBackground}"
                                         SelectionOpacity="0.35"
                                         ToolTip="Search notes"
                                         AutomationProperties.Name="Search notes" />

                                <TextBlock Text="Search notes"
                                           VerticalAlignment="Center"
                                           Margin="12,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ImportButton"
                                    Content="Import ▾"
                                    Margin="0,0,6,0"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Click="ImportButton_Click"
                                    ToolTip="Import notes from JSON backup (Merge or Replace)"
                                    AutomationProperties.Name="Import notes">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📥 Merge Notes (Keep existing notes)"
                                                  Command="{Binding ImportNotesMergeCommand}"
                                                  ToolTip="Adds notes from backup file without removing your existing notes." />
                                        <MenuItem Header="⚠️ Replace All Notes (Overwrite existing)..."
                                                  Command="{Binding ImportNotesReplaceCommand}"
                                                  ToolTip="Replaces all current notes with notes from the backup file. A safety backup will be created first." />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Export"
                                    Margin="0,0,6,0"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Command="{Binding ExportNotesCommand}"
                                    ToolTip="Export notes to JSON backup"
                                    AutomationProperties.Name="Export notes" />
                            <Button Content="Backup"
                                    Margin="0,0,12,0"
                                    Padding="8,4"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Command="{Binding BackupNotesCommand}"
                                    ToolTip="Create instant backup snapshot"
                                    AutomationProperties.Name="Backup notes" />
                            <CheckBox IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Content="Start with Windows"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      AutomationProperties.Name="Start with Windows" />
                        </StackPanel>
                    </Grid>

                    <!-- Filter & Organization Bar -->
                    <WrapPanel VerticalAlignment="Center">
                        <!-- Workspace Filter -->
                        <TextBlock Text="Workspace:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding Workspaces}"
                                  SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  MinWidth="110" Height="26" Margin="0,0,4,0"
                                  ToolTip="Filter by workspace"
                                  AutomationProperties.Name="Workspace selector" />

                        <!-- Workspace Actions Menu -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                            <MenuItem Header="⚙"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                      ToolTip="Manage Workspaces"
                                      AutomationProperties.Name="Workspace options">
                                <MenuItem Header="New Workspace..." Command="{Binding PromptCreateWorkspaceCommand}" />
                                <MenuItem Header="Rename Current Workspace..." Command="{Binding PromptRenameWorkspaceCommand}" />
                                <MenuItem Header="Delete Current Workspace" Command="{Binding PromptDeleteWorkspaceCommand}" />
                            </MenuItem>
                        </Menu>

                        <!-- Category Filter -->
                        <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                  MinWidth="90" Height="26" Margin="0,0,10,0"
                                  ToolTip="Filter by category"
                                  AutomationProperties.Name="Category filter" />

                        <!-- Tag Filter -->
                        <TextBlock Text="Tag:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <ComboBox ItemsSource="{Binding AllTags}"
                                  SelectedItem="{Binding SelectedTagFilter, Mode=TwoWay}"
                                  MinWidth="90" Height="26" Margin="0,0,10,0"
                                  ToolTip="Filter by tag"
                                  AutomationProperties.Name="Tag filter" />

                        <!-- Reminders Toggle -->
                        <CheckBox Content="⏰ Reminders"
                                  IsChecked="{Binding ShowRemindersOnly, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  ToolTip="Show only notes with reminders"
                                  AutomationProperties.Name="Reminders filter" />

                        <!-- Clear Filters Button -->
                        <Button Content="Clear Filters"
                                Command="{Binding ClearFiltersCommand}"
                                Margin="0,0,10,0"
                                Padding="8,2"
                                Height="26"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                ToolTip="Reset all filters"
                                AutomationProperties.Name="Clear all filters" />

                        <!-- Sort Menu -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                            <MenuItem Header="Sort Notes ▾"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Height="26"
                                      AutomationProperties.Name="Sort notes menu">
                                <MenuItem Header="Default order" Command="{Binding SetSortModeCommand}" CommandParameter="Default" />
                                <MenuItem Header="Title A → Z" Command="{Binding SetSortModeCommand}" CommandParameter="TitleAscending" />
                                <MenuItem Header="Title Z → A" Command="{Binding SetSortModeCommand}" CommandParameter="TitleDescending" />
                                <MenuItem Header="Last modified (newest first)" Command="{Binding SetSortModeCommand}" CommandParameter="ModifiedNewest" />
                                <MenuItem Header="Last modified (oldest first)" Command="{Binding SetSortModeCommand}" CommandParameter="ModifiedOldest" />
                                <MenuItem Header="Date created (newest first)" Command="{Binding SetSortModeCommand}" CommandParameter="CreatedNewest" />
                                <MenuItem Header="Date created (oldest first)" Command="{Binding SetSortModeCommand}" CommandParameter="CreatedOldest" />
                            </MenuItem>
                        </Menu>

                        <!-- Templates Menu -->
                        <Menu Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Header="Templates ▾"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Height="26"
                                      AutomationProperties.Name="Templates menu">
                                <MenuItem Header="New Blank Template..." Command="{Binding PromptCreateBlankTemplateCommand}" />
                                <Separator />
                                <MenuItem Header="Templates List" ItemsSource="{Binding Templates}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding DataContext.NewNoteFromTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}"
                                  Visibility="{Binding FilteredNotes, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=Invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190"
                                        Height="172"
                                        Margin="8"
                                        Background="{Binding BodyColor}"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource NoteCardBorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NoteCard_MouseLeftButtonDown"
                                        ToolTip="Open note">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" Opacity="0.12" ShadowDepth="2" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform Y="-2" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="14" Opacity="0.18" ShadowDepth="4" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Background="{Binding TitleBarColor}" CornerRadius="8,8,0,0" Padding="12,8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PreviewTextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,65,0" />
                                        </Border>

                                        <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,5,6,0">
                                            <Button Content="&#xE8C8;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DuplicateCommand}"
                                                Width="28"
                                                Height="28"
                                                Margin="0,0,4,0"
                                                Background="#33FFFFFF"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                Cursor="Hand"
                                                ToolTip="Duplicate note" />
                                            <Button Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DeleteCommand}"
                                                Width="28"
                                                Height="28"
                                                Background="#33FFFFFF"
                                                BorderThickness="0"
                                                Foreground="#AA0000"
                                                Cursor="Hand"
                                                ToolTip="Delete note" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Content, Converter={StaticResource StripTagsConverter}}"
                                                   Margin="10,10,10,4"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Foreground="{Binding PreviewTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <DockPanel Grid.Row="2" Margin="10,0,10,8" LastChildFill="False">
                                            <TextBlock Text="{Binding Category}"
                                                       DockPanel.Dock="Left"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding PreviewTextBrush}"
                                                       Opacity="0.8"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding HasCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="⏰"
                                                       DockPanel.Dock="Left"
                                                       FontSize="10"
                                                       Margin="0,0,4,0"
                                                       Visibility="{Binding HasReminder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text="Click to open"
                                                       DockPanel.Dock="Right"
                                                       FontSize="10"
                                                       Foreground="{Binding PreviewTextBrush}"
                                                       Opacity="0.65" />
                                        </DockPanel>
                                        <Border x:Name="DarkOverlay" Grid.RowSpan="3" Background="#22000000" Visibility="Collapsed" CornerRadius="8" IsHitTestVisible="False" />
                                    </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dark">
                                            <Setter TargetName="DarkOverlay" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="280"
                            Visibility="{Binding FilteredNotes, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                    <TextBlock Text="No notes found"
                               FontSize="22"
                               FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                               TextAlignment="Center" />
                    <TextBlock Text="Create a new note or adjust your search."
                               Margin="0,8,0,18"
                               FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Content="+ New Note"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding NewNoteCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
