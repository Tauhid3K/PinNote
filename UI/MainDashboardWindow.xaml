<Window x:Class="PinNote.UI.MainDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PinNote.UI"
        mc:Ignorable="d"
        Title="PinNote - All Notes"
        Height="500"
        Width="800"
        MinWidth="500"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#11000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressed}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <local:StripTagsConverter x:Key="StripTagsConverter" />
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
        <local:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter" />
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.15" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PinNote" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text=" - My Notes" FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}" Margin="5,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <!-- System theme button removed from main window; kept in tray menu -->
                            <Button Tag="Light" Command="{Binding SetThemeCommand}" CommandParameter="Light" ToolTip="Light theme" FontFamily="Segoe MDL2 Assets" Content="&#xE706;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                                                <Setter Property="Background" Value="#11000000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Tag="Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark" ToolTip="Dark theme" FontFamily="Segoe MDL2 Assets" Content="&#xE708;">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeMode}" Value="Dark">
                                                <Setter Property="Background" Value="#11000000" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Button Content="&#xE946;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Command="{Binding HelpCommand}"
                                ToolTip="Instructions" />
                        <Button Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click"
                                ToolTip="Minimize" />
                        <Button x:Name="MaximizeButton"
                                Content="&#xE922;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Maximize_Click"
                                ToolTip="Maximize" />
                        <Button Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Close_Click"
                                ToolTip="Close" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="#EEE">
                <Grid Margin="15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="+ New Note"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NewNoteCommand}" />

                    <Border Grid.Column="1" Background="#F3F3F3" CornerRadius="4" Margin="20,0" Height="36">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="8,0"
                                     Padding="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search notes" />

                        <TextBlock Text="Search notes"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Content="Start with Windows"
                              Foreground="{DynamicResource PrimaryTextBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer Padding="15" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredNotes}"
                                  Visibility="{Binding FilteredNotes, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=Invert}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="190"
                                        Height="172"
                                        Margin="8"
                                        Background="{Binding BodyColor}"
                                        CornerRadius="8"
                                        BorderBrush="#16000000"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="NoteCard_MouseLeftButtonDown"
                                        ToolTip="Open note">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="8" Opacity="0.12" ShadowDepth="2" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <TranslateTransform Y="-2" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="14" Opacity="0.18" ShadowDepth="4" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Background="{Binding TitleBarColor}" CornerRadius="8,8,0,0" Padding="12,8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <Button Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Command="{Binding DeleteCommand}"
                                                Width="28"
                                                Height="28"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,5,6,0"
                                                Background="#33FFFFFF"
                                                BorderThickness="0"
                                                Foreground="#AA0000"
                                                Cursor="Hand"
                                                ToolTip="Delete note" />

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Content, Converter={StaticResource StripTagsConverter}}"
                                                   Margin="10,10,10,4"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Foreground="{Binding TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Row="2"
                                                   Text="Click to open"
                                                   Margin="10,0,10,10"
                                                   FontSize="11"
                                                   Foreground="{Binding TextBrush}"
                                                   Opacity="0.65" />
                                        <Border x:Name="DarkOverlay" Grid.RowSpan="3" Background="#22000000" Visibility="Collapsed" CornerRadius="8" IsHitTestVisible="False" />
                                    </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ThemeMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="Dark">
                                            <Setter TargetName="DarkOverlay" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="280"
                            Visibility="{Binding FilteredNotes, Converter={StaticResource CollectionEmptyToVisibilityConverter}}">
                    <TextBlock Text="No notes found"
                               FontSize="22"
                               FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                               TextAlignment="Center" />
                    <TextBlock Text="Create a new note or adjust your search."
                               Margin="0,8,0,18"
                               FontSize="13"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Content="+ New Note"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding NewNoteCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
